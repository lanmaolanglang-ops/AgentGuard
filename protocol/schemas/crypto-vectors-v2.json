{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentguard:crypto-vectors:2.0.0",
  "type": "object",
  "properties": {
    "key_id": {
      "const": "PUBLIC_TEST_ONLY"
    },
    "key_hex": {
      "const": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    },
    "vectors": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CV[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "maxLength": 128
          },
          "domain": {
            "enum": [
              "operation-v2",
              "secret-v2"
            ]
          },
          "input": {
            "$ref": "#/$defs/value"
          },
          "encoded_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          },
          "framed_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          },
          "hmac_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "description",
          "domain",
          "input",
          "encoded_hex",
          "framed_hex",
          "hmac_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "key_id",
    "key_hex",
    "vectors"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "maxItems": 128,
          "minItems": 0
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
